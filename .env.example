# ONVIF Camera
ONVIF_ADDR=192.168.1.138:8089/onvif/device_service

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-3.5-turbo

# TTS
TTS_PROVIDER=edge-tts
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 转发到流媒体服务器（mediamtx）
MEDIAMTX_URL=
MEDIAMTX_USERNAME=
MEDIAMTX_PASSWORD=
MEDIAMTX_TLS=false
FORWARD_AUTODISCOVER=false
FORWARD_DISCOVER_INTERVAL=30

# Server
PORT=8080
